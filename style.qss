QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: Consolas, "Courier New", monospace;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #3c3c3c;
    background-color: #252526;
}

QTabBar::tab {
    background: #2d2d2d;
    color: #cccccc;
    padding: 6px 12px;
    margin: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #007acc,
        stop:1 #005a9e
    );
    color: #ffffff;
}

QTabBar::tab:hover {
    background: #3a3d41;
}

QPushButton {
    background-color: #0e639c;
    color: #ffffff;
    border-radius: 4px;
    padding: 6px 12px;
    border: 1px solid #007acc;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #0b4f7a;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #6d6d6d;
    border: 1px solid #3c3c3c;
}

QToolButton {
    background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #3a3d41;
}

QLineEdit, QPlainTextEdit, QComboBox, QSpinBox, QTextBrowser {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 4px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    selection-background-color: #094771;
}

QListWidget {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
}

QListWidget::item:selected {
    background-color: #094771;
}

QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    color: #4ec9b0;
}

QProgressBar {
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    text-align: center;
    background-color: #1e1e1e;
    color: #cccccc;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #0e639c,
        stop:1 #007acc
    );
}

QLabel {
    color: #cccccc;
}

QLabel#TitleLabel {
    font-size: 16pt;
    font-weight: bold;
    color: #ffffff;
}

QLabel#HintLabel {
    color: #8f8f8f;
}

QLabel#ErrorLabel {
    color: #f48771;
}

QStatusBar {
    color: #9d9d9d;
    background: #007acc;
    color: #ffffff;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
}

QSplitter::handle {
    background-color: #3c3c3c;
}
