/* Main application style - Modern Dark Theme */
QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Segoe UI", "Microsoft YaHei", Arial, sans-serif;
    font-size: 8pt;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    background-color: #252526;
    border-radius: 6px;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2d2d2d,
        stop:1 #252526);
    color: #cccccc;
    padding: 8px 16px;
    margin: 2px 1px 0px 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #0078d4,
        stop:0.5 #005a9e,
        stop:1 #0078d4
    );
    color: #ffffff;
    border-bottom: 2px solid #0078d4;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3a3d41,
        stop:1 #2d2d2d);
}

/* Buttons */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0078d4,
        stop:1 #005a9e);
    color: #ffffff;
    border-radius: 4px;
    padding: 4px 10px;
    border: 1px solid #0078d4;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1a86d9,
        stop:1 #0066b8);
    border: 1px solid #1a86d9;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #005a9e,
        stop:1 #004578);
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #6d6d6d;
    border: 1px solid #3c3c3c;
}

/* Tool Buttons */
QToolButton {
    background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px;
    min-width: 28px;
    min-height: 28px;
}

QToolButton:hover {
    background-color: #3a3d41;
    border: 1px solid #0078d4;
}

QToolButton:pressed {
    background-color: #252526;
}

/* Input Fields */
QLineEdit, QPlainTextEdit, QComboBox, QSpinBox, QTextBrowser {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #0078d4;
    background-color: #252526;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #cccccc;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    selection-background-color: #094771;
    selection-color: #ffffff;
    outline: none;
}

/* List Widget */
QListWidget {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 4px;
    border-radius: 3px;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #094771,
        stop:1 #0d5a8f);
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #2d2d2d;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 6px;
    padding: 8px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #4ec9b0;
    font-weight: bold;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    text-align: center;
    background-color: #1e1e1e;
    color: #ffffff;
    font-weight: bold;
    min-height: 18px;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #0078d4,
        stop:0.5 #00a4ef,
        stop:1 #0078d4
    );
    border-radius: 3px;
}

/* Labels */
QLabel {
    color: #cccccc;
}

QLabel#TitleLabel {
    font-size: 12pt;
    font-weight: bold;
    color: #ffffff;
    padding: 2px;
}

QLabel#HintLabel {
    color: #8f8f8f;
    font-style: italic;
}

QLabel#ErrorLabel {
    color: #f48771;
    font-weight: bold;
}

/* Status Bar */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0078d4,
        stop:1 #005a9e);
    color: #ffffff;
    border-top: 1px solid #3c3c3c;
    padding: 2px;
}

QStatusBar::item {
    border: none;
}

/* Check Box */
QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #1e1e1e;
}

QCheckBox::indicator:hover {
    border: 1px solid #0078d4;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border: 1px solid #0078d4;
    image: none;
}

QCheckBox::indicator:checked:hover {
    background-color: #1a86d9;
}

/* Splitter */
QSplitter::handle {
    background-color: #3c3c3c;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

/* Scroll Bar */
QScrollBar:vertical {
    border: none;
    background: #1e1e1e;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3c3c3c;
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4d51;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #1e1e1e;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #3c3c3c;
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #4a4d51;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Table Widget */
QTableWidget {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    gridline-color: #3c3c3c;
    selection-background-color: #094771;
    selection-color: #ffffff;
}

QTableWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QTableWidget::item:hover:!selected {
    background-color: #2d2d2d;
}

QHeaderView::section {
    background-color: #2d2d2d;
    color: #cccccc;
    padding: 6px;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #3a3d41;
}

/* Menu Bar */
QMenuBar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 4px 8px;
}

/* Dialog */
QDialog {
    background-color: #1e1e1e;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}
