Set fs = CreateObject("Scripting.FileSystemObject")
Set f = fs.CreateTextFile("build.bat", True, False)
f.WriteLine "@echo off"
f.WriteLine "chcp 65001 >nul"
f.WriteLine "echo ========================================"
f.WriteLine "echo   ZIPps - Build Script v2.7.0"
f.WriteLine "echo ========================================"
f.WriteLine "echo."
f.WriteLine ""
f.WriteLine "cd /d %~dp0.."
f.WriteLine ""
f.WriteLine "echo [1/5] Checking PyInstaller..."
f.WriteLine "python -m pip show pyinstaller >nul 2>&1"
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo Installing PyInstaller..."
f.WriteLine "    python -m pip install pyinstaller"
f.WriteLine "    if errorlevel 1 ("
f.WriteLine "        echo ERROR: Failed to install PyInstaller"
f.WriteLine "        pause"
f.WriteLine "        exit /b 1"
f.WriteLine "    )"
f.WriteLine ") else ("
f.WriteLine "    echo PyInstaller found."
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [2/5] Checking dependencies..."
f.WriteLine "python -m pip show PySide6 >nul 2>&1"
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo Installing PySide6..."
f.WriteLine "    python -m pip install PySide6"
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "python -m pip show cryptography >nul 2>&1"
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo Installing cryptography..."
f.WriteLine "    python -m pip install cryptography"
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [3/5] Cleaning old build/dist folders..."
f.WriteLine "if exist build rmdir /s /q build"
f.WriteLine "if exist dist rmdir /s /q dist"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [4/5] Compiling to EXE..."
f.WriteLine "python -m PyInstaller --clean .dev\ZIPps.spec"
f.WriteLine ""
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo."
f.WriteLine "    echo ERROR: Compilation failed"
f.WriteLine "    pause"
f.WriteLine "    exit /b 1"
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [5/5] Copying to .dev\dist..."
f.WriteLine "if not exist .dev\dist mkdir .dev\dist"
f.WriteLine "copy /Y dist\ZIPps.exe .dev\dist\ZIPps.exe"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo Cleaning builder files..."
f.WriteLine "if exist build rmdir /s /q build"
f.WriteLine "if exist dist rmdir /s /q dist"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo ========================================"
f.WriteLine "echo   Compilation completed successfully!"
f.WriteLine "echo ========================================"
f.WriteLine "echo."
f.WriteLine "echo EXE file: .dev\dist\ZIPps.exe"
f.WriteLine "echo."
f.WriteLine "pause"
f.Close
