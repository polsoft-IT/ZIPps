Set fs = CreateObject("Scripting.FileSystemObject")
Set f = fs.CreateTextFile("build.bat", True, True)
f.WriteLine "@echo off"
f.WriteLine "chcp 65001 >nul"
f.WriteLine "echo ========================================"
f.WriteLine "echo   ZIPps - Build Script v2.7.0"
f.WriteLine "echo ========================================"
f.WriteLine "echo."
f.WriteLine ""
f.WriteLine "cd /d ""%~dp0.."""
f.WriteLine ""
f.WriteLine "echo [1/5] Sprawdzanie PyInstaller..."
f.WriteLine "python -m pip show pyinstaller >nul 2>&1"
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo Instalowanie PyInstaller..."
f.WriteLine "    python -m pip install pyinstaller"
f.WriteLine "    if errorlevel 1 ("
f.WriteLine "        echo BLAD: Nie udalo sie zainstalowac PyInstaller"
f.WriteLine "        pause"
f.WriteLine "        exit /b 1"
f.WriteLine "    )"
f.WriteLine ") else ("
f.WriteLine "    echo PyInstaller znaleziony."
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [2/5] Sprawdzanie zaleznosci..."
f.WriteLine "python -m pip show PySide6 >nul 2>&1"
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo Instalowanie PySide6..."
f.WriteLine "    python -m pip install PySide6"
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "python -m pip show cryptography >nul 2>&1"
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo Instalowanie cryptography..."
f.WriteLine "    python -m pip install cryptography"
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "python -m pip show py7zr >nul 2>&1"
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo Instalowanie py7zr..."
f.WriteLine "    python -m pip install py7zr"
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [3/5] Czyszczenie starych plikow build/dist..."
f.WriteLine "if exist ""build"" rmdir /s /q ""build"""
f.WriteLine "if exist ""dist"" rmdir /s /q ""dist"""
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [4/5] Kompilacja do EXE..."
f.WriteLine "pyinstaller --clean "".dev\ZIPps.spec"""
f.WriteLine ""
f.WriteLine "if errorlevel 1 ("
f.WriteLine "    echo."
f.WriteLine "    echo BLAD: Kompilacja nie powiodla sie"
f.WriteLine "    pause"
f.WriteLine "    exit /b 1"
f.WriteLine ")"
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo [5/5] Kopiowanie do .dev\dist..."
f.WriteLine "if not exist "".dev\dist"" mkdir "".dev\dist"""
f.WriteLine "copy /Y ""dist\ZIPps.exe"" "".dev\dist\ZIPps.exe"""
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo Czyszczenie plikow buildera..."
f.WriteLine "if exist ""build"" rmdir /s /q ""build"""
f.WriteLine "if exist ""dist"" rmdir /s /q ""dist"""
f.WriteLine ""
f.WriteLine "echo."
f.WriteLine "echo ========================================"
f.WriteLine "echo   Kompilacja zakonczona pomyslnie!"
f.WriteLine "echo ========================================"
f.WriteLine "echo."
f.WriteLine "echo Plik EXE: .dev\dist\ZIPps.exe"
f.WriteLine "echo."
f.WriteLine "pause"
f.Close
